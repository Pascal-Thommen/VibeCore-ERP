    "/api/v1/payments/{shop_process_id}/rollback": {
      "post": {
        "tags": [
          "vPOS Payments"
        ],
        "summary": "Rollback / Cancel Payment",
        "description": "Reverses an authorized or pending transaction with Bancard and updates audit trail.",
        "operationId": "rollback_payment_api_v1_payments__shop_process_id__rollback_post",
        "parameters": [
          {
            "name": "shop_process_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Shop Process Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollbackRequest",
                "default": {
                  "reason": "Customer cancellation or timeout"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollbackResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
