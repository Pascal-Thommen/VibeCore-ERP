    "/api/v1/webhooks/dead-letter": {
      "get": {
        "tags": [
          "Resilience"
        ],
        "summary": "List Dead-Letter Webhooks",
        "description": "Lists un-deliverable outbound webhooks queued after exhausted retries.",
        "operationId": "list_dead_letters_api_v1_webhooks_dead_letter_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeadLetterItem"
                  },
                  "title": "Response List Dead Letters Api V1 Webhooks Dead Letter Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
