# VibeCore S3 Storage Adapter Configuration

# S3 Endpoint URL (e.g., http://localhost:9000 for MinIO, https://<account>.r2.cloudflarestorage.com for Cloudflare R2, or omit/leave empty for AWS S3)
STORAGE_ENDPOINT_URL=http://localhost:9000

# Public Endpoint URL for presigned URLs (used when Docker containers run on internal networks, e.g., http://localhost:9000)
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000

# S3 Credentials
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Bucket and Region
STORAGE_BUCKET=vibecore-documents
STORAGE_REGION=us-east-1

# S3 Addressing Style: "auto", "path", or "virtual" (Use "path" for MinIO)
STORAGE_ADDRESSING_STYLE=path

# Optional API Key for securing the adapter endpoints (Header: X-API-Key)
# Leave empty in local development to bypass API Key check
STORAGE_API_KEY=

# Upload Limits & TTL
STORAGE_DEFAULT_PRESIGNED_TTL=3600
STORAGE_MAX_UPLOAD_SIZE_BYTES=52428800

# Networking & Resilience
STORAGE_CONNECT_TIMEOUT=5.0
STORAGE_READ_TIMEOUT=30.0
STORAGE_MAX_RETRIES=3
