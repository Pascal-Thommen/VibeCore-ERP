# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# VibeCore JWT & Session Configuration (ADR 0004)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=vibecore-auth
JWT_AUDIENCE=vibeshell

# Cookie Security & CSRF
COOKIE_SECRET=replace-with-a-secure-secret-for-signing-oauth-state-cookies-min-32-bytes
COOKIE_SECURE=false

# Role Mapping & Access Control
ADMIN_EMAILS=["pascal@vibecore.org","pascalsolarluchs@gmail.com"]
DEFAULT_ROLE=USER
