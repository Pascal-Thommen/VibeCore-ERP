{
  "openapi": "3.1.0",
  "info": {
    "title": "VibeCore Auth Adapter",
    "description": "Isolated Google OAuth 2.0 & OpenID Connect (OIDC) SSO Microservice for VibeCore ERP.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Liveness and Healthcheck",
        "description": "Returns current health state, service version, and OAuth configuration status.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Readiness Check",
        "description": "Verifies that all required cryptographic secrets and configuration parameters are loaded.",
        "operationId": "get_readiness_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google/login": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Initiate Google OAuth 2.0 Login with PKCE",
        "description": "Generates PKCE verifier, computes S256 challenge, signs CSRF state, and redirects to Google.",
        "operationId": "google_login_auth_google_login_get",
        "parameters": [
          {
            "name": "redirect_after_login",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client redirect URI upon login completion",
              "title": "Redirect After Login"
            },
            "description": "Client redirect URI upon login completion"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON payload with authorization URL when requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginInitiationResponse"
                }
              }
            }
          },
          "307": {
            "description": "Redirect to Google Accounts Authorization Endpoint"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Google OAuth 2.0 Authorization Callback & Token Exchange",
        "description": "Validates CSRF state, exchanges authorization code for tokens via PKCE, verifies Google ID token signatures, and issues VibeCore JWT.",
        "operationId": "google_callback_auth_google_callback_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Google authorization code",
              "title": "Code"
            },
            "description": "Google authorization code"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Returned CSRF state parameter",
              "title": "State"
            },
            "description": "Returned CSRF state parameter"
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Google OAuth error code if user declined",
              "title": "Error"
            },
            "description": "Google OAuth error code if user declined"
          },
          {
            "name": "error_description",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Google OAuth error description",
              "title": "Error Description"
            },
            "description": "Google OAuth error description"
          },
          {
            "name": "vibecore_oauth_state",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vibecore Oauth State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid authorization code or state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token verification failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Google service timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Get Authenticated User Profile & Roles",
        "description": "Validates VibeCore session JWT from Bearer Authorization header or session cookie and returns userinfo.",
        "operationId": "get_current_user_auth_me_get",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "vibecore_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vibecore Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Logout & Terminate Session",
        "description": "Clears session and state cookies, terminating the local user session.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable error description"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Technical detail or context"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id",
            "description": "Correlation Trace ID"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall health state",
            "default": "healthy"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service identifier",
            "default": "vibecore-auth-adapter"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Service version",
            "default": "0.1.0"
          },
          "google_oauth_configured": {
            "type": "boolean",
            "title": "Google Oauth Configured",
            "description": "Whether Google OAuth credentials are set"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 current timestamp"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Extensible metadata"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "google_oauth_configured",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "LoginInitiationResponse": {
        "properties": {
          "authorization_url": {
            "type": "string",
            "title": "Authorization Url",
            "description": "Full Google OAuth 2.0 authorization URL with PKCE"
          },
          "state": {
            "type": "string",
            "title": "State",
            "description": "Cryptographic CSRF state parameter"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Extensible metadata"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "authorization_url",
          "state"
        ],
        "title": "LoginInitiationResponse"
      },
      "LogoutResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Logout confirmation",
            "default": "logged_out"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human readable message",
            "default": "Erfolgreich abgemeldet."
          }
        },
        "type": "object",
        "title": "LogoutResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service readiness state",
            "default": "ready"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks",
            "description": "Status of individual readiness checks"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 current timestamp"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "checks",
          "timestamp"
        ],
        "title": "ReadinessResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "Signed VibeCore session JWT token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "OAuth2 token type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Token validity in seconds",
            "default": 3600
          },
          "user": {
            "$ref": "#/components/schemas/UserInfo",
            "description": "Authenticated user profile and roles"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Extensible metadata"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data",
            "description": "Extensible custom data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "TokenResponse"
      },
      "UserInfo": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Unique user identifier mapped from Google sub"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Verified email address from Google"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Full display name"
          },
          "picture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Picture",
            "description": "Avatar image URL"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles",
            "description": "Assigned VibeCore roles"
          },
          "auth_provider": {
            "type": "string",
            "title": "Auth Provider",
            "description": "Identity provider name",
            "default": "google"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Extensible metadata"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data",
            "description": "Extensible custom data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "user_id",
          "email"
        ],
        "title": "UserInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}