{
  "openapi": "3.1.0",
  "info": {
    "title": "VibeCore Auth Microservice",
    "description": "Standalone Google OAuth 2.0 Identity Provider (IdP) for VibeCore ERP and AIBill with PKCE, RS256/EdDSA asymmetric tokens, JWKS, multi-tenancy, and Prometheus metrics.",
    "version": "0.1.0"
  },
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "OIDC Discovery & JWKS"
        ],
        "summary": "Root JWKS endpoint for stateless token validation",
        "operationId": "root_jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JWKSResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/openid-configuration": {
      "get": {
        "tags": [
          "OIDC Discovery & JWKS"
        ],
        "summary": "OpenID Connect Discovery Configuration",
        "operationId": "openid_configuration__well_known_openid_configuration_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenIDConfigurationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Liveness and Healthcheck (Kubernetes standard)",
        "description": "Returns current health state, service version, and OAuth configuration status.",
        "operationId": "get_healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Healthcheck (Legacy alias for /healthz)",
        "description": "Returns current health state for backwards compatibility.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Readiness Check (Kubernetes standard)",
        "description": "Verifies that all required cryptographic secrets, keys, and configuration parameters are loaded.",
        "operationId": "get_readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Readiness Check (Legacy alias for /readyz)",
        "operationId": "get_ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Observability & Health"
        ],
        "summary": "Prometheus Metrics Endpoint",
        "description": "Returns runtime metrics formatted for Prometheus scrapers in text/plain format.",
        "operationId": "get_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/auth/.well-known/jwks.json": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Public JWKS Key Set",
        "description": "Returns RFC 7517 JSON Web Key Set containing active public signing keys for stateless validation.",
        "operationId": "get_auth_jwks_auth__well_known_jwks_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JWKSResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google/login": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Initiate Google OAuth 2.0 Login with PKCE",
        "description": "Generates PKCE verifier, computes S256 challenge, signs CSRF state, and redirects to Google.",
        "operationId": "google_login_auth_google_login_get",
        "parameters": [
          {
            "name": "redirect_after_login",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client redirect URI upon login completion",
              "title": "Redirect After Login"
            },
            "description": "Client redirect URI upon login completion"
          },
          {
            "name": "org_hint",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional organization or tenant hint for user assignment",
              "title": "Org Hint"
            },
            "description": "Optional organization or tenant hint for user assignment"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON payload with authorization URL when requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginInitiationResponse"
                }
              }
            }
          },
          "307": {
            "description": "Redirect to Google Accounts Authorization Endpoint"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Google OAuth 2.0 Callback & Code Exchange",
        "description": "Validates CSRF state, exchanges auth code via PKCE, verifies Google ID Token signature, assigns tenant, and issues RS256 token pair.",
        "operationId": "google_callback_auth_google_callback_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Authorization code from Google",
              "title": "Code"
            },
            "description": "Authorization code from Google"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CSRF state parameter",
              "title": "State"
            },
            "description": "CSRF state parameter"
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Google OAuth error if user cancelled",
              "title": "Error"
            },
            "description": "Google OAuth error if user cancelled"
          },
          {
            "name": "error_description",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Google OAuth error description",
              "title": "Error Description"
            },
            "description": "Google OAuth error description"
          },
          {
            "name": "vibecore_oauth_state",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vibecore Oauth State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid authorization code or state token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Google signature validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Timeout contacting Google OAuth API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/token/refresh": {
      "post": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Refresh VibeCore Session Tokens",
        "description": "Validates cryptographic signature of refresh token and issues a new access token and rotated refresh token.",
        "operationId": "refresh_token_auth_token_refresh_post",
        "parameters": [
          {
            "name": "vibecore_refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vibecore Refresh Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid token type or missing refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Expired or invalid refresh token signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Get Authenticated User Profile & Roles",
        "description": "Validates Bearer token or session cookie and returns user profile, tenant ID, and assigned roles.",
        "operationId": "get_me_auth_me_get",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "vibecore_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vibecore Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or invalid session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Stateless Token Verification",
        "description": "Verifies an access token and returns verified identity and tenant info.",
        "operationId": "verify_token_endpoint_auth_verify_post",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Access token to verify",
              "title": "Token"
            },
            "description": "Access token to verify"
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Google OAuth 2.0 & OIDC SSO"
        ],
        "summary": "Log Out and Clear Session",
        "description": "Clears session cookies and invalidates local authentication state.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable error description"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Technical detail or context"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id",
            "description": "Correlation Trace ID"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall health state",
            "default": "healthy"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service identifier",
            "default": "vibecore-auth"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Service version",
            "default": "0.1.0"
          },
          "google_oauth_configured": {
            "type": "boolean",
            "title": "Google Oauth Configured",
            "description": "Whether Google OAuth credentials are set"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 current timestamp"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Extensible metadata"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "google_oauth_configured",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "JWKSResponse": {
        "properties": {
          "keys": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Keys",
            "description": "List of RFC 7517 compliant JSON Web Keys"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "keys"
        ],
        "title": "JWKSResponse"
      },
      "LoginInitiationResponse": {
        "properties": {
          "authorization_url": {
            "type": "string",
            "title": "Authorization Url",
            "description": "Full Google OAuth 2.0 authorization URL with PKCE"
          },
          "state": {
            "type": "string",
            "title": "State",
            "description": "Cryptographic CSRF state parameter"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Extensible metadata"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "authorization_url",
          "state"
        ],
        "title": "LoginInitiationResponse"
      },
      "LogoutResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Logout confirmation",
            "default": "logged_out"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human readable message",
            "default": "Erfolgreich abgemeldet."
          }
        },
        "type": "object",
        "title": "LogoutResponse"
      },
      "OpenIDConfigurationResponse": {
        "properties": {
          "issuer": {
            "type": "string",
            "title": "Issuer",
            "description": "OIDC Issuer URL"
          },
          "authorization_endpoint": {
            "type": "string",
            "title": "Authorization Endpoint",
            "description": "OAuth 2.0 authorization endpoint"
          },
          "token_endpoint": {
            "type": "string",
            "title": "Token Endpoint",
            "description": "OAuth 2.0 token endpoint"
          },
          "jwks_uri": {
            "type": "string",
            "title": "Jwks Uri",
            "description": "Public JWKS URL"
          },
          "userinfo_endpoint": {
            "type": "string",
            "title": "Userinfo Endpoint",
            "description": "OIDC userinfo endpoint"
          },
          "response_types_supported": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Response Types Supported",
            "default": [
              "code"
            ]
          },
          "subject_types_supported": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Subject Types Supported",
            "default": [
              "public"
            ]
          },
          "id_token_signing_alg_values_supported": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Id Token Signing Alg Values Supported",
            "default": [
              "RS256",
              "EdDSA"
            ]
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint",
          "jwks_uri",
          "userinfo_endpoint"
        ],
        "title": "OpenIDConfigurationResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service readiness state",
            "default": "ready"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks",
            "description": "Status of individual readiness checks"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 current timestamp"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "checks",
          "timestamp"
        ],
        "title": "ReadinessResponse"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token",
            "description": "VibeCore issued refresh token"
          },
          "tenant_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Hint",
            "description": "Optional tenant hint override or validation"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "RefreshTokenRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "Signed VibeCore session JWT access token (RS256)"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token",
            "description": "Signed VibeCore refresh token (7 days validity)"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "OAuth2 token type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Access token validity in seconds",
            "default": 3600
          },
          "refresh_expires_in": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Expires In",
            "description": "Refresh token validity in seconds (7 days)",
            "default": 604800
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "description": "Assigned multi-tenant identifier"
          },
          "user": {
            "$ref": "#/components/schemas/UserInfo",
            "description": "Authenticated user profile and roles"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
