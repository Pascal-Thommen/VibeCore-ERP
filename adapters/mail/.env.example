# Server Configuration
HOST=0.0.0.0
PORT=8025
ENVIRONMENT=development
LOG_LEVEL=info
MAIL_API_KEY=change-me-to-a-secure-random-token-32b

# SMTP Provider Settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_123456789abcdef
SMTP_FROM_EMAIL=rechnungen@vibecore.py
SMTP_FROM_NAME=VibeCore ERP
SMTP_TLS_POLICY=opportunistic
SMTP_CONNECT_TIMEOUT=10s
SMTP_SEND_TIMEOUT=30s

# IMAP Mailbox Settings
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=inbound@vibecore.py
IMAP_PASSWORD=app-specific-password
IMAP_USE_TLS=true
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL=30s
IMAP_IDLE_ENABLED=true
IMAP_MARK_AS_SEEN=true

# Persistent Queue Settings (bbolt)
QUEUE_DB_PATH=data/mail_queue.db
QUEUE_MAX_RETRIES=5
QUEUE_BASE_BACKOFF=2s
QUEUE_MAX_BACKOFF=60s
QUEUE_WORKER_CONCURRENCY=2
QUEUE_POLL_INTERVAL=1s

# Limits
MAX_ATTACHMENT_SIZE_MB=25

# Outbound Event & Status Dispatcher
STATUS_WEBHOOK_URL=http://localhost:8000/api/v1/adapters/mail/events
STATUS_WEBHOOK_SECRET=webhook-hmac-secret-string-32b
STATUS_WEBHOOK_TIMEOUT=10s

# Inbound Webhook Secrets
RESEND_WEBHOOK_SECRET=
BREVO_WEBHOOK_KEY=
SENDGRID_PUBLIC_KEY=
