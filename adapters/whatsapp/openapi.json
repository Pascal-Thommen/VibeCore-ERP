{
  "openapi": "3.1.0",
  "info": {
    "title": "VibeCore WhatsApp Cloud API Adapter",
    "description": "Slim Meta WhatsApp Cloud API microservice for OTP verification and template notifications.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Liveness check for container orchestrators.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Ready",
        "description": "Readiness check validating runtime configuration.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhook": {
      "get": {
        "tags": [
          "webhook"
        ],
        "summary": "Meta Webhook Verification",
        "description": "Handle Meta's subscription challenge verification.",
        "operationId": "meta_webhook_verification_api_v1_webhook_get",
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hub.Mode"
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hub.Verify Token"
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hub.Challenge"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "webhook"
        ],
        "summary": "Meta Webhook Event",
        "description": "Receive and process incoming messages and delivery status updates from Meta.",
        "operationId": "meta_webhook_event_api_v1_webhook_post",
        "parameters": [
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Hub-Signature-256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEventAck"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/send-template": {
      "post": {
        "tags": [
          "messaging"
        ],
        "summary": "Send Template Message",
        "description": "Send a pre-approved template message via Meta WhatsApp Cloud API.",
        "operationId": "send_template_message_api_v1_messages_send_template_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendTemplateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/otp/send": {
      "post": {
        "tags": [
          "otp"
        ],
        "summary": "Send Otp Code",
        "description": "Generate a cryptographically secure OTP and transmit it via WhatsApp Cloud API.",
        "operationId": "send_otp_code_api_v1_otp_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpGenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/otp/verify": {
      "post": {
        "tags": [
          "otp"
        ],
        "summary": "Verify Otp Code",
        "description": "Validate a submitted OTP code against active sessions.",
        "operationId": "verify_otp_code_api_v1_otp_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpVerifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "vibecore-whatsapp-adapter"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "HealthResponse"
      },
      "OtpGenerateRequest": {
        "properties": {
          "phone_number": {
            "type": "string",
            "minLength": 6,
            "title": "Phone Number",
            "description": "Target recipient phone number"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose",
            "description": "Purpose tag: sso_login, approval, etc.",
            "default": "sso_login"
          },
          "expiry_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Seconds",
            "description": "Custom expiration in seconds"
          },
          "template_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Template Name",
            "description": "Optional override for WhatsApp OTP template name"
          },
          "language_code": {
            "type": "string",
            "title": "Language Code",
            "description": "Template language code",
            "default": "es"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "phone_number"
        ],
        "title": "OtpGenerateRequest",
        "description": "Request to generate and transmit an OTP code via WhatsApp."
      },
      "OtpGenerateResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "reference_id": {
            "type": "string",
            "title": "Reference Id"
          },
          "phone_number": {
            "type": "string",
            "title": "Phone Number"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "whatsapp_message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Whatsapp Message Id"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "success",
          "reference_id",
          "phone_number",
          "expires_at"
        ],
        "title": "OtpGenerateResponse",
        "description": "Response after creating and dispatching an OTP session."
      },
      "OtpStatus": {
        "type": "string",
        "enum": [
          "verified",
          "expired",
          "invalid_code",
          "max_attempts_exceeded",
          "not_found",
          "already_used"
        ],
        "title": "OtpStatus",
        "description": "Lifecycle status of a one-time password."
      },
      "OtpVerifyRequest": {
        "properties": {
          "phone_number": {
            "type": "string",
            "minLength": 6,
            "title": "Phone Number"
          },
          "code": {
            "type": "string",
            "maxLength": 10,
            "minLength": 4,
            "title": "Code"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose",
            "default": "sso_login"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "phone_number",
          "code"
        ],
        "title": "OtpVerifyRequest",
        "description": "Request to verify a submitted OTP code."
      },
      "OtpVerifyResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "status": {
            "$ref": "#/components/schemas/OtpStatus"
          },
          "phone_number": {
            "type": "string",
            "title": "Phone Number"
          },
          "reference_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Id"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "success",
          "status",
          "phone_number",
          "message"
        ],
        "title": "OtpVerifyResponse",
        "description": "Result of OTP verification."
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ready"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "SendResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "recipient": {
            "type": "string",
            "title": "Recipient"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "success",
          "recipient",
          "status"
        ],
        "title": "SendResponse",
        "description": "Standardized delivery response from the WhatsApp adapter."
      },
      "SendTemplateRequest": {
        "properties": {
          "to": {
            "type": "string",
            "minLength": 6,
            "title": "To",
            "description": "Recipient phone number with country code"
          },
          "template_name": {
            "type": "string",
            "minLength": 1,
            "title": "Template Name",
            "description": "Template name in Meta Business Manager"
          },
          "language_code": {
            "type": "string",
            "title": "Language Code",
            "description": "Language code such as 'es' or 'en_US'",
            "default": "es"
          },
          "body_parameters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Body Parameters",
            "description": "Positional text parameters substituting {{1}}, {{2}} in template body"
          },
          "button_parameters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Button Parameters",
            "description": "URL or OTP payload parameters for template buttons"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta",
            "description": "Optional metadata object"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data",
            "description": "Optional custom client data"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "to",
          "template_name"
        ],
        "title": "SendTemplateRequest",
        "description": "Request payload to send a pre-approved WhatsApp template message."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WebhookEventAck": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "processed_messages": {
            "type": "integer",
            "title": "Processed Messages"
          },
          "processed_statuses": {
            "type": "integer",
            "title": "Processed Statuses"
          },
          "statuses": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Statuses"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
