        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "success",
          "processed_messages",
          "processed_statuses"
        ],
        "title": "WebhookEventAck",
        "description": "Acknowledgment returned by the webhook processor."
      }
    }
  }
}
