  "components": {
    "schemas": {
      "DteHeaderInput": {
        "properties": {
          "timbrado_number": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "title": "Timbrado Number"
          },
          "establishment_code": {
            "type": "string",
            "pattern": "^\\d{3}$",
            "title": "Establishment Code",
            "default": "001"
          },
          "point_of_issue_code": {
            "type": "string",
            "pattern": "^\\d{3}$",
            "title": "Point Of Issue Code",
            "default": "001"
          },
          "document_number": {
            "type": "string",
            "pattern": "^\\d{7}$",
            "title": "Document Number"
          },
          "issue_date": {
            "type": "string",
            "format": "date-time",
            "title": "Issue Date"
          },
          "security_code": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "title": "Security Code"
          },
          "emission_type": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Emission Type",
            "default": 1
          },
          "contributor_type": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Contributor Type",
            "default": 2
          },
          "issuer_ruc": {
            "type": "string",
            "pattern": "^\\d{5,8}$",
            "title": "Issuer Ruc"
          },
          "issuer_dv": {
            "type": "string",
            "pattern": "^\\d$",
            "title": "Issuer Dv"
          },
          "issuer_legal_name": {
            "type": "string",
            "title": "Issuer Legal Name"
          },
          "issuer_trade_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuer Trade Name"
          },
          "issuer_address": {
            "type": "string",
            "title": "Issuer Address",
            "default": "Asuncion, Paraguay"
          },
          "issuer_city": {
            "type": "string",
            "title": "Issuer City",
            "default": "Asuncion"
          },
          "issuer_department_code": {
            "type": "string",
            "title": "Issuer Department Code",
            "default": "1"
          },
          "issuer_district_code": {
            "type": "string",
            "title": "Issuer District Code",
            "default": "1"
          },
          "issuer_city_code": {
            "type": "string",
            "title": "Issuer City Code",
            "default": "1"
          },
          "issuer_economic_activity_code": {
            "type": "string",
            "title": "Issuer Economic Activity Code",
            "default": "62010"
          },
          "issuer_economic_activity_desc": {
            "type": "string",
            "title": "Issuer Economic Activity Desc",
            "default": "Actividades de programacion informatica"
          },
          "receiver_ruc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receiver Ruc"
          },
          "receiver_dv": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receiver Dv"
          },
          "receiver_doc_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receiver Doc Number"
          },
          "receiver_doc_type": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receiver Doc Type"
          },
          "receiver_legal_name": {
            "type": "string",
            "title": "Receiver Legal Name",
            "default": "Consumidor Final"
          },
          "receiver_nature": {
            "type": "integer",
            "title": "Receiver Nature",
            "default": 1
          },
          "operation_type": {
            "type": "integer",
            "title": "Operation Type",
            "default": 1
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "PYG"
          },
          "exchange_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Exchange Rate",
            "default": "1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timbrado_number",
          "document_number",
          "issue_date",
          "security_code",
          "issuer_ruc",
          "issuer_dv",
          "issuer_legal_name"
        ],
        "title": "DteHeaderInput",
        "description": "Input header data for SIFEN DTE generation."
      },
      "DteItemInput": {
        "properties": {
          "line_number": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Line Number"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "default": ""
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "unit_of_measure": {
            "type": "string",
            "title": "Unit Of Measure",
            "default": "77"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Price"
          },
          "discount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Discount",
            "default": "0"
          },
          "tax_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Tax Rate",
            "default": "10"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line_number",
          "description",
          "quantity",
          "unit_price"
        ],
        "title": "DteItemInput",
        "description": "Input line item for SIFEN DTE generation."
      },
      "DteOutboxResponse": {
        "properties": {
          "cdc": {
            "type": "string",
            "title": "Cdc"
          },
          "dte_type": {
            "type": "integer",
            "title": "Dte Type"
          },
          "issuer_ruc": {
            "type": "string",
            "title": "Issuer Ruc"
          },
          "document_number": {
            "type": "string",
            "title": "Document Number"
          },
          "total_amount": {
            "type": "string",
            "title": "Total Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "$ref": "#/components/schemas/OutboxStatus"
          },
          "sifen_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sifen Code"
          },
          "sifen_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sifen Message"
          },
          "protocol_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol Number"
          },
          "retry_count": {
            "type": "integer",
            "title": "Retry Count"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "xml_payload": {
            "type": "string",
            "title": "Xml Payload"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "transmitted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transmitted At"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "type": "object",
        "required": [
          "cdc",
          "dte_type",
          "issuer_ruc",
          "document_number",
          "total_amount",
          "currency",
          "status",
          "retry_count",
          "xml_payload",
          "created_at",
          "updated_at"
        ],
        "title": "DteOutboxResponse",
        "description": "Response representing a DTE submission or outbox entry."
      },
      "GenerateXmlRequest": {
        "properties": {
          "header": {
            "$ref": "#/components/schemas/DteHeaderInput"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/DteItemInput"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          },
          "profile": {
            "$ref": "#/components/schemas/MandantRucProfile"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "custom_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Data"
          }
        },
        "type": "object",
        "required": [
          "header",
          "items",
          "profile"
        ],
        "title": "GenerateXmlRequest",
        "description": "Request payload for generating SIFEN DTE XML."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MandantObligacion": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "MandantObligacion",
        "description": "A registered tax obligation on the taxpayer's RUC profile."
      },
      "MandantRucProfile": {
        "properties": {
          "ruc": {
            "type": "string",
            "pattern": "^\\d{5,8}$",
            "title": "Ruc"
          },
          "dv": {
            "type": "string",
            "pattern": "^\\d$",
            "title": "Dv"
          },
          "legal_name": {
            "type": "string",
            "title": "Legal Name"
          },
          "trade_name": {
            "anyOf": [
              {
