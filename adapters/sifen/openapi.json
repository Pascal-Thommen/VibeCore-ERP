                    "$ref": "#/components/schemas/DteOutboxResponse"
                  },
                  "title": "Response List Outbox Records Api V1 Sifen Outbox Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/outbox/{cdc}": {
      "get": {
        "tags": [
          "SIFEN Electronic Invoicing"
        ],
        "summary": "Retrieve DTE submission and Outbox status by 44-digit CDC",
        "operationId": "get_outbox_record_api_v1_sifen_outbox__cdc__get",
        "parameters": [
          {
            "name": "cdc",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cdc"
            }
          },
          {
            "name": "X-Adapter-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Adapter-Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
