{
  "openapi": "3.1.0",
  "info": {
    "title": "VibeCore SIFEN Adapter API",
    "version": "1.0.0",
    "description": "Isolated adapter service for Paraguayan SIFEN electronic invoicing and dynamic DTE resolution."
  },
  "paths": {
    "/api/v1/sifen/resolve": {
      "post": {
        "summary": "Resolve Mandant RUC profile into DTE type and tax calculation policy",
        "operationId": "resolveRucProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MandantRucProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved DTE configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedProfile"
                }
              }
            }
          },
          "400": {
            "description": "Invalid RUC profile or missing tax obligation"
          }
        }
      }
    },
    "/api/v1/sifen/generate-xml": {
      "post": {
        "summary": "Generate official SIFEN XML for Factura Electrónica or Boleta Resimple Electrónica",
        "operationId": "generateSifenXml",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateXmlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated XML document",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Validation or calculation error"
          }
        }
      }
    },
    "/api/v1/sifen/contingencia/issue": {
      "post": {
        "summary": "Issue electronic document with automatic failover to Contingencia",
        "operationId": "issueContingenciaDocument",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["header", "items", "profile"],
                "properties": {
                  "header": { "type": "object" },
                  "items": { "type": "array", "items": { "type": "object" } },
                  "profile": { "$ref": "#/components/schemas/MandantRucProfile" },
                  "force_offline": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document issued with KuDE customer receipt and outbox record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContingenciaIssueResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/contingencia/queue": {
      "get": {
        "summary": "List documents in durable outbox queue",
        "operationId": "listOutboxQueue",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of outbox records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ContingenciaRecord" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/contingencia/sync": {
      "post": {
        "summary": "Trigger batch synchronization of queued offline documents with exponential backoff",
        "operationId": "syncPendingBatch",
        "responses": {
          "200": {
            "description": "Batch synchronization result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchSyncResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/contingencia/alerts": {
      "get": {
        "summary": "Check 72h legal deadline warnings and expired documents",
        "operationId": "check72hAlerts",
        "responses": {
          "200": {
            "description": "List of active deadline alerts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DeadlineAlert" }
                }
              }
            }
          }
        }
      }
    }
  },

  "components": {
    "schemas": {
      "MandantRucProfile": {
        "type": "object",
        "required": ["ruc", "dv", "legal_name", "obligaciones"],
        "properties": {
          "ruc": {
            "type": "string",
            "pattern": "^[0-9]{5,8}$"
          },
          "dv": {
            "type": "string",
            "pattern": "^[0-9]$"
          },
          "legal_name": {
            "type": "string"
          },
          "trade_name": {
            "type": "string",
            "nullable": true
          },
          "obligaciones": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "ResolvedProfile": {
        "type": "object",
        "required": [
          "regime",
          "obligation_code",
          "dte_type",
          "dte_type_code",
          "dte_type_description",
          "iva_applicable",
          "requires_iva_breakdown"
        ],
        "properties": {
          "regime": {
            "type": "string",
            "enum": ["IRE_GENERAL", "IRE_SIMPLE", "IRE_RESIMPLE"]
          },
          "obligation_code": {
            "type": "integer"
          },
          "dte_type": {
            "type": "integer"
          },
          "dte_type_code": {
            "type": "string"
          },
          "dte_type_description": {
            "type": "string"
          },
          "iva_applicable": {
            "type": "boolean"
          },
          "requires_iva_breakdown": {
            "type": "boolean"
          }
        }
      },
      "GenerateXmlRequest": {
        "type": "object",
        "required": ["header", "items", "profile"],
        "properties": {
          "header": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "profile": {
            "$ref": "#/components/schemas/MandantRucProfile"
          }
        }
      }
    }
  }
}
