{
  "openapi": "3.1.0",
  "info": {
    "title": "VibeCore SIFEN Adapter API",
    "description": "Isolated adapter service for Paraguayan SIFEN electronic invoicing and dynamic DTE resolution.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/sifen/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Microservice health check endpoint.",
        "operationId": "health_check_api_v1_sifen_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Api V1 Sifen Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Microservice health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/resolve": {
      "post": {
        "tags": [
          "SIFEN"
        ],
        "summary": "Resolve Mandant RUC profile into DTE type and tax calculation policy",
        "description": "Resolve taxpayer RUC profile into official DTE type and IVA regime.",
        "operationId": "resolve_profile_api_v1_sifen_resolve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MandantRucProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/generate-xml": {
      "post": {
        "tags": [
          "SIFEN"
        ],
        "summary": "Generate official SIFEN XML for Factura Electr\u00f3nica or Boleta Resimple Electr\u00f3nica",
        "description": "Generate compliant SIFEN v150 XML according to taxpayer regime.",
        "operationId": "generate_xml_api_v1_sifen_generate_xml_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateXmlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Generated XML document",
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Validation or calculation error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/sign": {
      "post": {
        "tags": [
          "SIFEN"
        ],
        "summary": "Sign SIFEN XML with XMLDSig and generate official KuDE QR code",
        "description": "Digitally sign XML document with PKCS#12 certificate and attach QR code.",
        "operationId": "sign_xml_api_v1_sifen_sign_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sifen/sign-and-send": {
      "post": {
        "tags": [
          "SIFEN"
        ],
        "summary": "Sign XML with XMLDSig, generate QR, and transmit to DNIT e-Kuatia via SOAP 1.2 / mTLS",
        "description": "Sign DTE and transmit to DNIT e-Kuatia SOAP webservice.",
        "operationId": "sign_and_send_api_v1_sifen_sign_and_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignAndSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignAndSendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
