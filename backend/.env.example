# Use DATABASE_URL for a complete local connection string, or use the individual
# values below. Do not commit a real .env file.
APP_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vibecore
DATABASE_USER=vibecore
DATABASE_PASSWORD=replace-with-a-local-development-secret
# DATABASE_URL=postgresql+psycopg://vibecore:password@localhost:5432/vibecore
